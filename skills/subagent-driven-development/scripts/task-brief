#!/usr/bin/env python3
"""Extract one validated task brief from an implementation plan."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

TASK_RE = re.compile(r"^(#{1,6})\s+Task\s+(\d+)(?:\s*:\s*(.*)|\s+(.*))?\s*$", re.IGNORECASE)
HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*#*\s*$")
FENCE_RE = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
REQUIRED = ("Target", "Change", "Acceptance")


def scan(lines: list[str]) -> tuple[list[tuple[int, int, str, int]], list[bool]]:
    tasks: list[tuple[int, int, str, int]] = []
    fenced = [False] * len(lines)
    fence: tuple[str, int] | None = None
    for index, line in enumerate(lines):
        match = FENCE_RE.match(line)
        if match:
            marker = match.group(1)
            if fence is None:
                fence = (marker[0], len(marker))
                fenced[index] = True
                continue
            fenced[index] = True
            if marker[0] == fence[0] and len(marker) >= fence[1]:
                fence = None
            continue
        fenced[index] = fence is not None
        if fence is None and (task := TASK_RE.match(line)):
            title = (task.group(3) or task.group(4) or "").strip()
            tasks.append((int(task.group(2)), index, title, len(task.group(1))))
    if fence is not None:
        raise ValueError("unclosed Markdown fence")
    return tasks, fenced


def section_end(lines: list[str], fenced: list[bool], start: int, level: int) -> int:
    for index in range(start + 1, len(lines)):
        if fenced[index]:
            continue
        heading = HEADING_RE.match(lines[index])
        if heading and len(heading.group(1)) <= level:
            return index
    return len(lines)


def global_constraints(lines: list[str], fenced: list[bool]) -> list[str]:
    for index, line in enumerate(lines):
        if fenced[index]:
            continue
        heading = HEADING_RE.match(line)
        if heading and heading.group(2).strip().lower() == "global constraints":
            return lines[index : section_end(lines, fenced, index, len(heading.group(1)))]
    return []


def validate_task(lines: list[str]) -> list[str]:
    _, fenced = scan(lines)
    found: dict[str, list[str]] = {}
    active: str | None = None
    for index, line in enumerate(lines):
        if not fenced[index] and (heading := HEADING_RE.match(line)):
            name = next((item for item in REQUIRED if item.lower() == heading.group(2).strip().lower()), None)
            if name:
                found.setdefault(name, [])
                active = name
                continue
        if active:
            found[active].append(line)
    return [name for name in REQUIRED if name not in found or not any(line.strip() for line in found[name])]


def usage() -> int:
    print("usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]\n       task-brief --list PLAN_FILE", file=sys.stderr)
    return 2


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[0] == "--list":
        plan = Path(argv[1])
        if not plan.is_file():
            print(f"no such plan file: {plan}", file=sys.stderr)
            return 2
        try:
            tasks, _ = scan(plan.read_text().splitlines())
        except ValueError as error:
            print(str(error), file=sys.stderr)
            return 4
        for number, _, title, _ in tasks:
            print(f"{number}\t{title}")
        return 0

    if len(argv) not in (2, 3):
        return usage()
    plan = Path(argv[0])
    if not plan.is_file():
        print(f"no such plan file: {plan}", file=sys.stderr)
        return 2
    try:
        number = int(argv[1])
    except ValueError:
        return usage()

    lines = plan.read_text().splitlines()
    try:
        tasks, fenced = scan(lines)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 4
    matches = [task for task in tasks if task[0] == number]
    if len(matches) != 1:
        print(f"task {number} not found uniquely in {plan}", file=sys.stderr)
        return 3

    _, start, _, level = matches[0]
    brief = lines[start : section_end(lines, fenced, start, level)]
    missing = validate_task(brief)
    if missing:
        print(f"task {number} missing required section(s): {', '.join(missing)}", file=sys.stderr)
        return 5

    constraints = global_constraints(lines, fenced)
    if constraints:
        brief.extend(["", *constraints])

    if len(argv) == 3:
        out = Path(argv[2])
    else:
        workspace = subprocess.check_output([str(Path(__file__).with_name("sdd-workspace"))], text=True).strip()
        out = Path(workspace) / f"task-{number}-brief.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(brief) + "\n")
    print(f"wrote {out}: {len(brief)} lines")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
